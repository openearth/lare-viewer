{
  "logo": "/desirmed-nbracer.png",
  "logoWidth": "140px",
  "initialSetup": {
    "restartButton": true,
    "process": {
      "identifier": "lare-start",
      "trigger": "onStart",
      "inputs": [],
      "storeResultAs": "initialSetup"
    }
  },
  "legendStack": "horizontal",
  "steps": [
    {
      "id": "userCaseSelection",
      "title": "Use Case",
      "drawerTitle": "Select your use case",
      "disabledOnContinue": true,
      "confirmFlashWhenEnabled": true,
      "explanation": "Choose the use case that matches your analysis, then confirm to continue.",
      "requiresConfirmation": true,
      "confirmationSource": "component",
      "components": [
        {
          "component": "SelectionList",
          "componentProps": {
            "label": "Use cases",
            "selectionKey": "userCaseSelection",
            "flashWhenEnabled": true,
            "options": [
              {
                "id": "administration",
                "name": "Administration",
                "layerName": "region:nuts_2021_level_3",
                "regionIdProperty": "nuts_name",
                "layerNameForProcess": "region:nuts_2021"
              },
              {
                "id": "hydrobasin",
                "name": "Hydro basin",
                "layerName": "topography:hybas_eu_lev12_v1c",
                "regionIdProperty": "hybas_id",
                "layerNameForProcess": "hydro:hybas_eu_lev12_v1c"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "regionSelection",
      "title": "Region Selection",
      "drawerTitle": "Select a base map",
      "disabledOnContinue": true,
      "confirmFlashWhenEnabled": true,
      "requiredSteps": [
        "userCaseSelection"
      ],
      "icon": "mdi-map-marker-radius",
      "explanation": "Select a region on the map by clicking it, then confirm to continue.",
      "requiresConfirmation": true,
      "confirmationSource": "mapClick",
      "commitSelectionOnConfirm": true,
      "components": [
        {
          "component": "LayerList",
          "componentProps": {
            "conditionSource": "userCaseSelection",
            "layers": [
              {
                "id": "landuse:U2018_CLC2018_V2020_20u1_cog",
                "name": "European Land Use Cover",
                "active": true,
                "clickable": false
              },
              {
                "id": "region:nuts_2021_level_3",
                "name": "NUTS 3 Regions",
                "active": true,
                "clickable": true,
                "propertiesBox": "region",
                "flashWhenEnabled": true,
                "condition": "administration"
              },
              {
                "id": "topography:hybas_eu_lev12_v1c",
                "name": "Hydro Basins",
                "active": true,
                "clickable": true,
                "propertiesBox": "hydrobasin",
                "condition": "hydrobasin"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "uom",
      "title": "Calculate UOM",
      "icon": "mdi-city-variant-outline",
      "drawerTitle": "Calculate UOM",
      "disabledOnContinue": true,
      "confirmFlashWhenEnabled": true,
      "requiredSteps": [
        "regionSelection"
      ],
      "explanation": "Choose a landscape archetype and confirm, then enter the hexagon size, click the calculator to run the UOM calculation, then confirm to continue.",
      "requiresConfirmation": true,
      "confirmationSource": "process",
      "committedSelectionOutline": {
        "fromHere": true
      },
      "process": {
        "identifier": "lare-uom",
        "trigger": "component",
        "inputs": [
          {
            "id": "session_id",
            "source": "store:app.processResults.initialSetup.session_id"
          },
          {
            "id": "uom_size",
            "source": "payload:value"
          },
          {
            "id": "layer_name",
            "source": "store:app.selections.userCaseSelection.layerNameForProcess"
          },
          {
            "id": "id",
            "source": "store:map.activeRegionId"
          },
          {
            "id": "archetype",
            "source": "store:app.selections.uomArchetype"
          }
        ],
        "storeResultAs": "uom",
        "outputActions": [
          {
            "action": "addLayer",
            "path": "response",
            "layerId": "uomGrid"
          }
        ]
      },
      "components": [
        {
          "component": "SelectionList",
          "componentProps": {
            "label": "Landscape archetype",
            "selectionKey": "uomArchetype",
            "flashWhenEnabled": true,
            "options": [
              {
                "id": "coastal",
                "name": "Coastal"
              },
              {
                "id": "urban",
                "name": "Urban"
              },
              {
                "id": "rural",
                "name": "Rural"
              }
            ]
          }
        },
        {
          "component": "NumberInput",
          "componentProps": {
            "label": "Hexagon size (in m²)",
            "suffix": "m²",
            "min": 0,
            "max": 50000000,
            "step": 100000,
            "defaultValue": 1000,
            "defaultValueSource": "store:map.suggestedUom",
            "requiresCalcCondition": true,
            "calcConditionSource": "store:app.selections.uomArchetype",
            "flashWhenEnabled": true,
            "showCalcButton": true
          }
        }
      ]
    },
    {
      "id": "kcsSelection",
      "title": "KCS & Hazards",
      "drawerTitle": "Select KCS and hazard",
      "disabledOnContinue": true,
      "confirmFlashWhenEnabled": true,
      "requiredSteps": [
        "uom"
      ],
      "explanation": "Select hazard and KCS, then click Calculate KCS risk. When the risk layer appears on the map, confirm to continue to the NbS overview.",
      "requiresConfirmation": true,
      "confirmationSource": "process",
      "requiredSelections": [
        "hazardSelection",
        "kcsSelection"
      ],
      "process": {
        "identifier": "lare-uomkcs",
        "trigger": "component",
        "inputs": [
          {
            "id": "session_id",
            "source": "store:app.processResults.initialSetup.session_id"
          },
          {
            "id": "archetype",
            "source": "store:app.selections.uomArchetype"
          },
          {
            "id": "hazard",
            "source": "store:app.selections.hazardSelection"
          },
          {
            "id": "kcs",
            "source": "store:app.selections.kcsSelection"
          }
        ],
        "storeResultAs": "uomKcs",
        "outputActions": [
          {
            "action": "removeLayer",
            "layerId": "kcsRisk"
          },
          {
            "action": "addLayer",
            "path": "response",
            "layerId": "kcsRisk"
          }
        ]
      },
      "components": [
        {
          "component": "SelectionList",
          "componentProps": {
            "label": "Hazards",
            "selectionKey": "hazardSelection",
            "flashWhenEnabled": true,
            "conditionSource": "uomArchetype",
            "options": [
              {
                "id": "salinity",
                "name": "Salinity",
                "condition": "coastal"
              },
              {
                "id": "pluvial_RP200",
                "name": "Flood",
                "condition": "coastal"
              },
              {
                "id": "heat",
                "name": "Heat",
                "condition": "urban"
              },
              {
                "id": "drought",
                "name": "Drought",
                "condition": "rural"
              }
            ]
          }
        },
        {
          "component": "SelectionList",
          "componentProps": {
            "label": "KCS",
            "selectionKey": "kcsSelection",
            "flashWhenEnabled": true,
            "conditionSource": "hazardSelection",
            "disabledUntilCondition": true,
            "options": [
              {
                "id": "landuse",
                "name": "Agriculture",
                "condition": "salinity"
              },
              {
                "id": "transport",
                "name": "Transport",
                "condition": "pluvial_RP200"
              },
              {
                "id": "landuse",
                "name": "Agriculture",
                "condition": "drought"
              },
              {
                "id": "hospitals",
                "name": "Vulnerable population (Hospitals)",
                "condition": "heat"
              }
            ]
          }
        },
        {
          "component": "ProcessRunButton",
          "componentProps": {
            "label": "Calculate KCS risk",
            "requiredSelections": [
              "hazardSelection",
              "kcsSelection"
            ],
            "flashWhenEnabled": true
          }
        }
      ]
    },
    {
      "id": "nbsOverview",
      "title": "NbS Overview",
      "drawerTitle": "Nature-based solutions overview",
      "disabledOnContinue": false,
      "requiredSteps": [
        "kcsSelection"
      ],
      "explanation": "Hexagons are coloured by their most represented applicable NbS. Click a hexagon for details. Toggle Risk or land cover for context.",
      "requiresConfirmation": false,
      "onOpen": [
        {
          "action": "setLayerVisibility",
          "layerId": "kcsRisk",
          "visible": false,
          "once": true
        },
        {
          "action": "setLayerVisibility",
          "layerId": "uomGrid",
          "visible": false,
          "once": true
        }
      ],
      "process": {
        "identifier": "lare-nbs",
        "trigger": "stepOpen",
        "rerun": "onInputChange",
        "loadingText": "Calculating the NbS overview…",
        "errorText": "The NbS overview could not be calculated.",
        "inputs": [
          {
            "id": "session_id",
            "source": "store:app.processResults.initialSetup.session_id"
          },
          {
            "id": "archetype",
            "source": "store:app.selections.uomArchetype"
          },
          {
            "id": "hazard",
            "source": "store:app.selections.hazardSelection"
          }
        ],
        "storeResultAs": "nbs",
        "outputActions": [
          {
            "action": "addLayer",
            "path": "response",
            "layerId": "nbsOverview"
          }
        ]
      },
      "components": [
        {
          "component": "LayerList",
          "componentProps": {
            "layers": [
              {
                "id": "landuse:U2018_CLC2018_V2020_20u1_cog",
                "name": "European Land Use Cover",
                "active": false,
                "clickable": false
              },
              {
                "id": "kcsRisk",
                "name": "Risk",
                "active": false,
                "clickable": false
              },
              {
                "id": "nbsOverview",
                "name": "NbS Overview",
                "active": true,
                "clickable": true,
                "fitBoundsOnSelect": false,
                "featureInfo": {
                  "title": "NbS in this hexagon",
                  "emptyValue": "—",
                  "sections": [
                    {
                      "type": "fields",
                      "fields": [
                        {
                          "attribute": "nbs_list_majority",
                          "title": "Most represented NbS (map colour)",
                          "format": {
                            "type": "list",
                            "delimiter": ";",
                            "join": ", "
                          },
                          "categorySwatch": true
                        }
                      ]
                    },
                    {
                      "type": "table",
                      "title": "Top 5 land-cover classes and their NbS",
                      "repeat": {
                        "from": 1,
                        "to": 5,
                        "token": "n"
                      },
                      "hideRowWhenEmpty": [
                        "clc_rank_area_{n}"
                      ],
                      "columns": [
                        {
                          "title": "Land cover",
                          "attribute": "clc_rank_{n}",
                          "format": {
                            "type": "lookup",
                            "lookup": "clc"
                          }
                        },
                        {
                          "title": "NbS",
                          "attribute": "nbs_list_{n}",
                          "format": {
                            "type": "list",
                            "delimiter": ";",
                            "join": ", "
                          }
                        },
                        {
                          "title": "Total area",
                          "attribute": "clc_rank_area_{n}",
                          "format": {
                            "type": "number",
                            "scale": 0.0001,
                            "decimals": 1,
                            "unit": "ha"
                          }
                        },
                        {
                          "title": "% area",
                          "attribute": "clc_rank_pct_{n}",
                          "format": {
                            "type": "number",
                            "decimals": 1,
                            "unit": "%"
                          },
                          "hideWhenMissing": true
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ]
}