{
  "logo": "/desirmed_logo.png",
  "initialSetup": {
    "wps": {
      "identifier": "lare_start",
      "trigger": "onStart",
      "inputs": [],
      "storeResultAs": "initialSetup"
    }
  },
  "steps": [
    {
      "id": "userCaseSelection",
      "title": "Use Case",
      "drawerTitle": "Select your use case",
      "explanation": "Choose the use case that matches your analysis, then confirm to continue.",
      "requiresConfirmation": true,
      "confirmationSource": "component",
      "components": [
        {
          "component": "SelectionList",
          "componentProps": {
            "label": "Use cases",
            "selectionKey": "userCaseSelection",
            "options": [
              {
                "id": "administration",
                "name": "Administration",
                "layerName": "region:nuts_2021_level_3",
                "regionIdProperty": "nuts_name",
                "layerNameForWPS": "region:nuts_2021"
              },
              {
                "id": "hydrobasin",
                "name": "Hydro basin",
                "layerName": "topography:hybas_eu_lev12_v1c",
                "regionIdProperty": "hybas_id",
                "layerNameForWPS": "hydro:hybas_eu_lev12_v1c"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "regionSelection",
      "title": "Region Selection",
      "drawerTitle": "Select a base map",
      "icon": "mdi-map-marker-radius",
      "requiredSteps": [
        "userCaseSelection"
      ],
      "explanation": "Select a region on the map by clicking it, then confirm to continue.",
      "requiresConfirmation": true,
      "confirmationSource": "mapClick",
      "components": [
        {
          "component": "LayerList",
          "componentProps": {
            "conditionSource": "userCaseSelection",
            "layers": [
              {
                "id": "landuse:U2018_CLC2018_V2020_20u1_cog",
                "name": "European Land Use Cover",
                "active": true,
                "clickable": false
              },
              {
                "id": "region:nuts_2021_level_3",
                "name": "NUTS 3 Regions",
                "active": true,
                "clickable": true,
                "propertiesBox": "region",
                "condition": "administration"
              },
              {
                "id": "topography:hybas_eu_lev12_v1c",
                "name": "Hydro Basins",
                "active": true,
                "clickable": true,
                "propertiesBox": "hydrobasin",
                "condition": "hydrobasin"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "uom",
      "title": "Calculate UOM",
      "icon": "mdi-city-variant-outline",
      "drawerTitle": "Calculate UOM",
      "requiredSteps": [
        "regionSelection"
      ],
      "explanation": "Enter the hexagon size, click the calculator to run the UOM calculation, then confirm to continue.",
      "requiresConfirmation": true,
      "confirmationSource": "wps",
      "wps": {
        "identifier": "lare_uom",
        "trigger": "component",
        "inputs": [
          {
            "id": "sessionid",
            "type": "LiteralData",
            "source": "store:app.wpsResults.initialSetup.sessionid"
          },
          {
            "id": "uomsize",
            "type": "LiteralData",
            "source": "payload:value"
          },
          {
            "id": "layername",
            "type": "LiteralData",
            "source": "store:app.selections.userCaseSelection.layerNameForWPS"
          },
          {
            "id": "id",
            "type": "LiteralData",
            "source": "store:map.activeRegionId"
          }
        ],
        "storeResultAs": "uom",
        "outputActions": [
          {
            "action": "addLayer",
            "path": "layers"
          }
        ]
      },
      "components": [
        {
          "component": "NumberInput",
          "componentProps": {
            "label": "Hexagon size (in m²)",
            "suffix": "m²",
            "min": 100,
            "max": 50000000,
            "step": 100000,
            "defaultValue": 1000,
            "defaultValueSource": "store:map.suggestedUom",
            "showCalcButton": true
          }
        }
      ]
    },
    {
      "id": "archetypeSelection",
      "title": "Archetype Selection",
      "drawerTitle": "Select the archetype",
      "requiredSteps": [
        "uom"
      ],
      "explanation": "Select the archetype and confirm to continue.",
      "requiresConfirmation": true,
      "confirmationSource": "component",
      "wps": {
        "identifier": "lare_coastal",
        "trigger": "stepComplete",
        "inputs": [
          {
            "id": "sessionid",
            "type": "LiteralData",
            "source": "store:app.wpsResults.initialSetup.sessionid"
          }
        ],
        "storeResultAs": "coastalUseCase",
        "outputActions": [
          {
            "action": "removeLayer",
            "fromResultKey": "uom",
            "path": "layers"
          },
          {
            "action": "addLayer",
            "path": "layers"
          }
        ]
      },
      "components": [
        {
          "component": "SelectionList",
          "componentProps": {
            "label": "Archetypes",
            "selectionKey": "archetypeSelection",
            "options": [
              {
                "id": "coastal",
                "name": "Urban Coastal"
              },
              {
                "id": "agricultural_land",
                "name": "Agricultural Land"
              },
              {
                "id": "rural_settlements",
                "name": "Rural Settlements"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "kcsSelection",
      "title": "KCS & Hazards",
      "drawerTitle": "Select KCS and hazard",
      "requiredSteps": [
        "archetypeSelection"
      ],
      "explanation": "Select KCS and hazard type, then confirm to run the UOM KCS calculation.",
      "requiresConfirmation": true,
      "confirmationSource": "component",
      "wps": {
        "identifier": "lare_kcs",
        "trigger": "stepComplete",
        "inputs": [
          {
            "id": "archetype",
            "type": "LiteralData",
            "source": "store:app.selections.archetypeSelection"
          },
          {
            "id": "kcs",
            "type": "LiteralData",
            "source": "store:app.selections.kcsSelection"
          },
          {
            "id": "sessionid",
            "type": "LiteralData",
            "source": "store:app.wpsResults.initialSetup.sessionid"
          },
          {
            "id": "hazard",
            "type": "LiteralData",
            "source": "store:app.selections.hazardSelection"
          }
        ],
        "storeResultAs": "uomKcs",
        "outputActions": [
          {
            "action": "addLayer",
            "path": "layers"
          }
        ]
      },
      "components": [
        {
          "component": "SelectionList",
          "componentProps": {
            "label": "KCS",
            "selectionKey": "kcsSelection",
            "options": [
              {
                "id": "transport",
                "name": "Transport"
              }
            ]
          }
        },
        {
          "component": "SelectionList",
          "componentProps": {
            "label": "Hazards",
            "selectionKey": "hazardSelection",
            "options": [
              {
                "id": "pluvial_RP200",
                "name": "Pluvial floods"
              }
            ]
          }
        }
      ]
    }
  ]
}