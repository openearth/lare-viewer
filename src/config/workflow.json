{
  "logo": "/desirmed_logo.png",
  "initialSetup": {
    "wps": {
      "identifier": "lare_start",
      "trigger": "onStart",
      "inputs": [],
      "storeResultAs": "initialSetup"
    }
  },
  "steps": [
    {
      "id": "userCaseSelection",
      "title": "Use Case",
      "drawerTitle": "Select your use case",
      "requiresConfirmation": true,
      "confirmationSource": "component",
      "components": [
        {
          "component": "SelectionList",
          "componentProps": {
            "label": "Use cases",
            "selectionKey": "userCaseSelection",
            "options": [
              {
                "id": "administration",
                "name": "Administration"
              },
              {
                "id": "hydrobasin",
                "name": "Hydro basin"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "regionSelection",
      "title": "Region Selection",
      "drawerTitle": "Select a base map",
      "icon": "mdi-map-marker-radius",
      "requiredSteps": [
        "userCaseSelection"
      ],
      "requiresConfirmation": true,
      "confirmationSource": "component",
      "components": [
        {
          "component": "LayerList",
          "componentProps": {
            "conditionSource": "userCaseSelection",
            "layers": [
              {
                "id": "landuse:U2018_CLC2018_V2020_20u1_cog",
                "name": "European Land Use Cover",
                "active": true,
                "clickable": false
              },
              {
                "id": "region:nuts_2021_level_3",
                "name": "NUTS 3 Regions",
                "active": true,
                "clickable": true,
                "propertiesBox": "region",
                "condition": "administration"
              },
              {
                "id": "topography:hybas_eu_lev12_v1c",
                "name": "Hydro Basins",
                "active": true,
                "clickable": true,
                "condition": "hydrobasin"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "uom",
      "title": "Calculate UOM",
      "icon": "mdi-city-variant-outline",
      "drawerTitle": "Calculate UOM",
      "requiredSteps": [
        "hazard"
      ],
      "requiresConfirmation": true,
      "confirmationSource": "component",
      "wps": {
        "identifier": "lare_uom",
        "trigger": "stepComplete",
        "inputs": [
          {
            "id": "nutsname",
            "type": "LiteralData",
            "source": "store:map.activeRegion.properties.nuts_name"
          },
          {
            "id": "uomsize",
            "type": "LiteralData",
            "source": "payload:value"
          }
        ],
        "storeResultAs": "uom"
      },
      "components": [
        {
          "component": "NumberInput",
          "componentProps": {
            "label": "Hexagon size (in m²)",
            "suffix": "m²",
            "min": 100,
            "max": 50000000,
            "step": 100000,
            "defaultValue": 1000,
            "defaultValueSource": "wpsResult:regionSelection.suggested_uom"
          }
        }
      ]
    }
  ]
}