{
  "logo": "/desirmed_logo.png",
  "menus": [
    {
      "id": "userCaseSelection",
      "title": "Use Case",
      "drawerTitle": "Select your use case",
      "components": [
        {
          "component": "SelectionList",
          "componentProps": {
            "label": "Use cases",
            "selectionKey": "userCaseSelection",
            "options": [
              {
                "id": "administration",
                "name": "Administration"
              },
              {
                "id": "hydrobasin",
                "name": "Hydro basin"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "regionSelection",
      "title": "Region Selection",
      "drawerTitle": "Select a base map",
      "icon": "mdi-map-marker-radius",
      "requiredSteps": [
        "userCaseSelection"
      ],
      "components": [
        {
          "component": "LayerList",
          "componentProps": {
            "conditionSource": "userCaseSelection",
            "layers": [
              {
                "id": "landuse:U2018_CLC2018_V2020_20u1_cog",
                "name": "European Land Use Cover",
                "active": true,
                "clickable": false
              },
              {
                "id": "region:nuts_2021_level_3",
                "name": "NUTS 3 Regions",
                "active": true,
                "clickable": true,
                "propertiesBox": "region",
                "condition": "administration"
              },
              {
                "id": "topography:hybas_eu_lev12_v1c",
                "name": "Hydro Basins",
                "active": true,
                "clickable": true,
                "condition": "hydrobasin"
              }
            ]
          }
        }
      ],
      "wps": {
        "identifier": "lare_region",
        "trigger": "mapClick",
        "inputs": [
          {
            "id": "nutsname",
            "type": "LiteralData",
            "source": "store:map.activeRegion.properties.nuts_name"
          }
        ],
        "storeResultAs": "regionSelection"
      }
    },
    {
      "id": "hazard",
      "title": "Hazard mitigation selection",
      "icon": "mdi-alert-circle-outline",
      "drawerTitle": "Select a hazard mitigation from the list",
      "requiredSteps": [
        "regionSelection"
      ],
      "wps": {
        "identifier": "lare_hazard",
        "trigger": "stepComplete",
        "inputs": [
          {
            "id": "nutsname",
            "type": "LiteralData",
            "source": "store:map.activeRegion.properties.nuts_name"
          },
          {
            "id": "hazard",
            "type": "LiteralData",
            "source": "payload:value"
          }
        ],
        "storeResultAs": "hazard"
      },
      "components": [
        {
          "component": "SelectionList",
          "componentProps": {
            "label": "Hazard mitigation maps",
            "options": [
              {
                "id": "flood",
                "name": "Flood mitigation"
              },
              {
                "id": "fire",
                "name": "Fire mitigation"
              },
              {
                "id": "erosion",
                "name": "Erosion mitigation"
              },
              {
                "id": "heat",
                "name": "Heatwave mitigation"
              },
              {
                "id": "drought",
                "name": "Drought mitigation"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "uom",
      "title": "Calculate UOM",
      "icon": "mdi-city-variant-outline",
      "drawerTitle": "Calculate UOM",
      "requiredSteps": [
        "hazard"
      ],
      "wps": {
        "identifier": "lare_uom",
        "trigger": "stepComplete",
        "inputs": [
          {
            "id": "nutsname",
            "type": "LiteralData",
            "source": "store:map.activeRegion.properties.nuts_name"
          },
          {
            "id": "uomsize",
            "type": "LiteralData",
            "source": "payload:value"
          }
        ],
        "storeResultAs": "uom"
      },
      "components": [
        {
          "component": "NumberInput",
          "componentProps": {
            "label": "Hexagon size (in m²)",
            "suffix": "m²",
            "min": 100,
            "max": 50000000,
            "step": 100000,
            "defaultValue": 1000,
            "defaultValueSource": "wpsResult:regionSelection.suggested_uom"
          }
        }
      ]
    },
    {
      "id": "assets",
      "title": "Assets",
      "drawerTitle": "Select an asset type",
      "icon": "mdi-city-variant-outline",
      "requiredSteps": [
        "uom"
      ],
      "completionEvent": "auto",
      "components": [
        {
          "component": "LayerList",
          "componentProps": {
            "layers": [
              {
                "id": "assets-roads",
                "name": "Roads",
                "active": false,
                "clickable": false
              },
              {
                "id": "assets-schools",
                "name": "Schools",
                "active": false,
                "clickable": false
              },
              {
                "id": "assets-hospitals",
                "name": "Hospitals",
                "active": false,
                "clickable": false
              },
              {
                "id": "assets-power-grid",
                "name": "Power Grid",
                "active": false,
                "clickable": false
              },
              {
                "id": "assets-bridges",
                "name": "Bridges",
                "active": false,
                "clickable": false
              }
            ]
          }
        }
      ]
    }
  ]
}