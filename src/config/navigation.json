{
  "logo": "/desirmed_logo.png",
  "menus": [
    {
      "id": "baseMaps",
      "title": "Base Maps",
      "drawerTitle": "Select a base map",
      "icon": "mdi-map-marker-radius",
      "completionEvent": "auto",
      "components": [
        {
          "component": "LayerList",
          "componentProps": {
            "layers": [
              {
                "id": "landuse:U2018_CLC2018_V2020_20u1_cog",
                "name": "European Land Use Cover",
                "active": true,
                "clickable": false
              },
              {
                "id": "region:nuts_2021_level_3",
                "name": "NUTS 3 Regions",
                "active": true,
                "clickable": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": "regionSelection",
      "title": "Region Selection",
      "icon": "mdi-hexagon-outline",
      "drawerTitle": "Select a region in the map",
      "requiredSteps": ["baseMaps"],
      "completionEvent": "auto",
      "wps": {
        "identifier": "test"
      }
    },
    {
      "id": "hazard",
      "title": "Hazard mitigation selection",
      "icon": "mdi-alert-circle-outline",
      "drawerTitle": "Select a hazard mitigation from the list",
      "requiredSteps": ["regionSelection"],
      "wps": {
        "identifier": "hazard"
      },
      "components": [
        {
          "component": "SelectionList",
          "componentProps": {
            "label": "Hazard mitigation maps",
            "options": [
              {
                "id": "flood",
                "name": "Flood mitigation"
              },
              {
                "id": "fire",
                "name": "Fire mitigation"
              },
              {
                "id": "erosion",
                "name": "Erosion mitigation"
              },
              {
                "id": "heat",
                "name": "Heatwave mitigation"
              },
              {
                "id": "drought",
                "name": "Drought mitigation"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "uom",
      "title": "Calculate UOM",
      "icon": "mdi-city-variant-outline",
      "drawerTitle": "Calculate UOM",
      "requiredSteps": ["hazard"],
      "components": [
        {
          "component": "NumberInput",
          "componentProps": {
            "label": "Hexagon size (in m)",
            "suffix": "m",
            "min": 100,
            "max": 10000,
            "step": 100,
            "defaultValue": 1000
          }
        }
      ]
    },
    {
      "id": "assets",
      "title": "Assets",
      "drawerTitle": "Select an asset type",
      "icon": "mdi-city-variant-outline",
      "requiredSteps": ["uom"],
      "completionEvent": "auto",
      "components": [
        {
          "component": "LayerList",
          "componentProps": {
            "layers": [
              {
                "id": "assets-roads",
                "name": "Roads",
                "active": false,
                "clickable": false
              },
              {
                "id": "assets-schools",
                "name": "Schools",
                "active": false,
                "clickable": false
              },
              {
                "id": "assets-hospitals",
                "name": "Hospitals",
                "active": false,
                "clickable": false
              },
              {
                "id": "assets-power-grid",
                "name": "Power Grid",
                "active": false,
                "clickable": false
              },
              {
                "id": "assets-bridges",
                "name": "Bridges",
                "active": false,
                "clickable": false
              }
            ]
          }
        }
      ]
    }
  ]
}
